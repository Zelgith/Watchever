{
  "expo": {
    "name": "Watchever",
    "slug": "watchever",
    "version": "1.0.0",
    "scheme": "watchever",
    "platforms": [
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.watchever.app",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
